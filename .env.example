# Copy to .env. Never commit your actual .env or data directory.
# Generate a password: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=replace-with-a-new-random-password
PUBLIC_URL=http://127.0.0.1:8080
# Comma-separated exact hostnames/IPs from camera links. No ports or paths.
CAMERA_HOSTS=old-iphone.your-tailnet.ts.net,192.168.1.50
